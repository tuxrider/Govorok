venv/
__pycache__/
*.py[cod]
.selftest-tmp/
build/
dist/
*.spec
*.log

# ─── артефакты диагностических скриптов (tools/) ────────────────────────────
tools/mic_probe.wav
tools/live_check.wav
tools/*.wav

# ─── локальные заметки и сторонние дампы документации ────────────────────
