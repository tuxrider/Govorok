config.json
.env
.env.*

# папка данных в репозитории быть не должно (норма — %APPDATA%\Govorok)
govorok_data/

# кеши и счётчики, которые приложение создаёт само
emotes_cache.json
counters.json
selftest-report.txt
*.lock

# ─── окружение и артефакты сборки ────────────────────────────────────────────
